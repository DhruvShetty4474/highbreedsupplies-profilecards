{
  "name": "highbreed",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir src --dir tests",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply highbreed --local",
    "db:migrate:remote": "wrangler d1 migrations apply highbreed --remote",
    "db:seed:local": "tsx scripts/seed.ts && wrangler d1 execute highbreed --local --file=.seed/seed.sql",
    "admin:grant": "node scripts/grant-admin.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:backup": "wrangler d1 export highbreed --remote --output=.seed/backup.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.23",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.58.0",
    "nanoid": "^5.1.16",
    "next": "^15.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@libsql/client": "^0.18.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
