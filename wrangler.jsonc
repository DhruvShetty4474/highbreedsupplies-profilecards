{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "highbreed",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Free https://highbreed.<subdomain>.workers.dev address (testing).
  "workers_dev": true,
  // GO-LIVE: once highfis.com shows "Active" in Cloudflare (nameservers
  // moved from Hostinger), uncomment these routes, set APP_URL below to
  // https://highfis.com, and redeploy. Wrangler creates DNS + certificates.
  // "routes": [
  //   { "pattern": "highfis.com", "custom_domain": true },
  //   { "pattern": "www.highfis.com", "custom_domain": true }
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "highbreed",
      "database_id": "dc8822d5-e79b-4eeb-b4eb-2f808efa7b68",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Non-secret settings. Secrets (BETTER_AUTH_SECRET, R2 keys, RESEND_API_KEY,
  // ...) are set with `npx wrangler secret put NAME` — never commit them.
  "vars": {
    "APP_URL": "https://highfis.com",
    "R2_BUCKET_NAME": "highbreed-media",
    "R2_PUBLIC_URL": "https://media.highfis.com",
    "MEDIA_MAX_IMAGE_MB": "5",
    "MEDIA_MAX_VIDEO_MB": "50",
    "MEDIA_QUOTA_MB_PER_USER": "100"
  }
}
