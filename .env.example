# Copy to .env.local for `next dev`. Production values go in wrangler
# vars/secrets (full documented list arrives in Phase 6).

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HIGHBREED

# Auth (Better Auth). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that become admins when they sign up
ADMIN_EMAILS=

# Database: Cloudflare D1 via the `DB` binding in wrangler.jsonc (no env var)

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=highbreed-media
R2_PUBLIC_URL=https://media.highbreedsupplies.com
