# =============================================================================
# HIGHBREED — environment variables
#
# Local:       copy to .env.local (next dev) AND .dev.vars (npm run preview).
# Production:  non-secrets go in `vars` in wrangler.jsonc;
#              secrets:  npx wrangler secret put NAME
#
# All values are validated by src/config.ts. A missing/invalid REQUIRED value
# stops the app with an error naming the variable. OPTIONAL services switch
# off cleanly when their keys are blank.
# =============================================================================

# --- App (required) -----------------------------------------------------------
# Public base URL. Used in NFC/QR card links (<APP_URL>/c/<token>), auth
# callbacks and emails. Production: https://highfis.com
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HIGHBREED
# Optional: other origins that may sign in (comma-separated). Use it for the
# https://highbreed.<subdomain>.workers.dev test URL before the domain is live.
TRUSTED_ORIGINS=

# --- Auth: Better Auth (required, SECRET) ------------------------------------
# Signs sessions and tokens. ≥32 chars. Generate: openssl rand -base64 32
# Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Comma-separated emails that get the admin role when they sign up.
# (Existing accounts: npm run admin:grant -- you@example.com [--remote])
ADMIN_EMAILS=

# "true" (default) = new accounts must enter the 6-digit code emailed to them
# before they can sign in. Without GMAIL_* keys the code is only printed to
# the server log (`npm run dev` terminal / `npx wrangler tail`).
REQUIRE_EMAIL_VERIFICATION=true

# --- Database: Cloudflare D1 -------------------------------------------------
# No env var. Bound as `DB` in wrangler.jsonc (d1_databases → database_id).

# --- Media: Cloudflare R2 (optional as a group; SECRETS) ----------------------
# Leave all four blank to disable uploads (the editor shows "Media storage is
# not configured"). Set all four to enable. Create keys under
# R2 → Manage R2 API Tokens (Object Read & Write, bucket-scoped).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=highbreed-media
# Public URL of the bucket's custom domain (serves uploaded files).
R2_PUBLIC_URL=https://media.highfis.com

# Per-file limits and per-user total storage, in MB.
MEDIA_MAX_IMAGE_MB=5
MEDIA_MAX_VIDEO_MB=50
MEDIA_QUOTA_MB_PER_USER=100

# --- Email (SECRETS) -----------------------------------------------------------
# OTP and password-reset emails are sent through the Gmail API as the Gmail
# account below. Get the three keys with:  npm run gmail:auth
# (one-time Google sign-in; see README → "Email via Gmail").
# Blank = emails are printed to the server log instead — local dev only.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_FROM=HIGHBREED SUPPLIES <highbreedsuppliesotp56@gmail.com>
# Alternative provider for a domain you own (can't send as @gmail.com).
RESEND_API_KEY=

# --- Google sign-in (optional; SECRET) ---------------------------------------
# Blank = no "Continue with Google" button. Create at
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorized redirect URI:
#   https://highfis.com/api/auth/callback/google
#   (and http://localhost:3000/api/auth/callback/google for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments: Razorpay (optional as a pair; SECRETS) ------------------------
# Blank = the UPI button is hidden; Cash (manager code) still works.
# Dashboard → Account & Settings → API Keys. Use rzp_test_... keys until KYC
# is approved, then switch to rzp_live_... keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → add https://highfis.com/api/webhooks/razorpay with
# events payment.captured + order.paid, and paste the secret you chose here.
# Catches payments where the customer closes the page before it confirms.
RAZORPAY_WEBHOOK_SECRET=

# --- Monitoring: Sentry (optional) --------------------------------------------
# Blank = errors only go to the Workers log.
SENTRY_DSN=
